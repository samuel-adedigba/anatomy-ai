# iOS simulator / local browser
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_VIEWER_URL=http://localhost:5173

# Android emulator: use these instead of the localhost values
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
# EXPO_PUBLIC_VIEWER_URL=http://10.0.2.2:5173

# Physical device: replace 192.168.1.42 with the development machine LAN IP
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3001
# EXPO_PUBLIC_VIEWER_URL=http://192.168.1.42:5173
