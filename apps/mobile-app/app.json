{
  "expo": {
    "name": "Anatomy AI",
    "slug": "anatomy-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#080C14"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anatomyai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080C14"
      },
      "package": "com.anatomyai.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ],
    "scheme": "anatomy-ai",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "anatomy-ai"
      }
    }
  }
}
