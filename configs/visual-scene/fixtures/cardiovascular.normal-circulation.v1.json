  "steps": [
    {
      "id": "heart-overview",
      "start_ms": 0,
      "end_ms": 3000,
      "caption": "The heart has four chambers that fill and contract in a repeating cardiac cycle."
    },
    {
      "id": "body-to-right-heart",
      "start_ms": 3000,
      "end_ms": 6000,
      "caption": "Oxygen-poor blood returns through the venae cavae, enters the right atrium, and passes through the tricuspid valve into the right ventricle."
    },
    {
      "id": "right-heart-to-lungs",
      "start_ms": 6000,
      "end_ms": 9500,
      "caption": "The right ventricle sends this blood through the pulmonary valve and pulmonary arteries toward the lungs."
    },
    {
      "id": "lungs-to-left-heart",
      "start_ms": 9500,
      "end_ms": 13000,
      "caption": "Oxygen-rich blood returns through the pulmonary veins, enters the left atrium, and passes through the mitral valve into the left ventricle."
    },
    {
      "id": "left-heart-to-body",
      "start_ms": 13000,
      "end_ms": 18000,
      "caption": "The left ventricle sends this blood through the aortic valve and aorta toward the body."
    }
  ],
