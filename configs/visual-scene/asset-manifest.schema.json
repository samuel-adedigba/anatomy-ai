{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anatomy-ai.local/schemas/asset-manifest.v1.json",
  "title": "Anatomy AI AssetManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "file",
    "sha256",
    "source",
    "modifications",
    "targets",
    "clips",
    "morphs",
    "paths",
    "materials",
    "coordinate_system",
    "units",
    "scale",
    "bounds",
    "performance",
    "review",
    "known_simplifications"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "asset_id": {
      "enum": [
        "heart.educational.v1",
        "circulation.major-vessels.v1"
      ]
    },
    "file": {
      "type": "string",
      "pattern": "^/models/[a-z0-9._/-]+\\.glb$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "url", "licence", "attribution"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "licence": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 }
      }
    },
    "modifications": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "heart",
          "heart.right_atrium",
          "heart.right_ventricle",
          "heart.left_atrium",
          "heart.left_ventricle",
          "heart.tricuspid_valve",
          "heart.pulmonary_valve",
          "heart.mitral_valve",
          "heart.aortic_valve",
          "heart.vena_cavae",
          "heart.pulmonary_artery",
          "heart.pulmonary_veins",
          "heart.aorta",
          "circulation.pulmonary",
          "circulation.systemic"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        ]
      }
    },
    "clips": {
      "type": "object",
      "propertyNames": { "enum": ["normal_cardiac_cycle"] },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "morphs": {
      "type": "object",
      "propertyNames": {
        "enum": ["atrial_systole", "ventricular_systole"]
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "paths": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "body_to_right_atrium",
          "right_ventricle_to_lungs",
          "lungs_to_left_atrium",
          "left_ventricle_to_body"
        ]
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "materials": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "default_tissue",
            "selected_structure",
            "oxygen_poor_blood",
            "oxygen_rich_blood"
          ]
        }
      }
    },
    "coordinate_system": { "enum": ["y_up", "z_up"] },
    "units": { "enum": ["metres", "centimetres", "millimetres"] },
    "scale": { "type": "number", "exclusiveMinimum": 0 },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/vector3" },
        "max": { "$ref": "#/$defs/vector3" }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "node_count", "mesh_count", "primitive_count"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "node_count": { "type": "integer", "minimum": 1 },
        "mesh_count": { "type": "integer", "minimum": 1 },
        "primitive_count": { "type": "integer", "minimum": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "role", "date"],
      "properties": {
        "status": { "enum": ["pending", "approved", "changes_required"] },
        "reviewer": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "date": {
          "oneOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "approved" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "reviewer": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "format": "date" }
            }
          }
        }
      ]
    },
    "known_simplifications": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false
    }
  }
}
